# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a free-tier key at https://aistudio.google.com/apikey
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_AUTH_TOKEN: Bearer token that protects every /api route.
# Required when NODE_ENV=production (the server refuses to start without it).
# Leave empty for local development to disable auth.
APP_AUTH_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-side Firestore / Storage)
# Keep these values in a real environment variable store, not inside source code.
# The app will work without Firebase if these are left empty.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID="movies-app-d646b"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# ---------------------------------------------------------------------------
# GPU worker mesh (Blocker A). The coordinator is this server. A worker is any
# machine that runs `node scripts/worker.mjs`; the coordinator places each job
# on one that advertises the engine the job needs. See docs/worker-mesh.md.
# ---------------------------------------------------------------------------
# WORKER_ROLE="gpu"                # gpu | cpu | phone. A phone is CPU-tier only.
# WORKER_GPU="Radeon RX 9070"
# WORKER_VRAM_GB="16"
# WORKER_ENGINES="comfyui,ffmpeg"
# WORKER_PORT="8090"
# WORKER_PUBLIC_URL=""             # how the coordinator reaches this worker
# WORKER_TOKEN=""                  # secret the coordinator must present
# COORDINATOR_TOKEN=""            # the coordinator's APP_AUTH_TOKEN (required in prod)
# COORDINATOR_URL="https://your-tunnel.trycloudflare.com"

# ---------------------------------------------------------------------------
# Hardening + quota (Blockers B, E). AI_DAILY_QUOTA caps AI work per client per
# UTC day (0 disables). ALLOWED_ORIGINS is a comma-separated CORS allowlist;
# empty means same-origin only.
# ---------------------------------------------------------------------------
# AI_DAILY_QUOTA="500"
# ALLOWED_ORIGINS=""
# RATE_LIMIT_PER_MIN="120"
# DIREK_JOBS_DB=""                 # durable job mirror (SQLite); default factory.db

# ---------------------------------------------------------------------------
# Local backends (optional). These can be left empty: open the app's SETUP
# panel and it writes direk.config.json for you. Environment variables still
# win over that file when both are set.
# ---------------------------------------------------------------------------
# COMFYUI_URL="http://127.0.0.1:8188"        # ComfyUI server (free images)
# COMFYUI_CHECKPOINT="sd_xl_base_1.0.safetensors"
# COMFYUI_LORAS_DIR="C:\ComfyUI\models\loras"
# KOHYA_DIR="C:\kohya_ss"                  # kohya_ss / sd-scripts (training)
# KOHYA_BASE_MODEL="C:\models\sd_xl_base_1.0.safetensors"
# KOHYA_PYTHON="python"        # Windows uses "python"; POSIX uses "python3"
# KOHYA_ACCELERATE="1"

# ---------------------------------------------------------------------------
# AI text model (Direk chat + Battle Room). Two free options:
#   - Gemini: set GEMINI_API_KEY (free tier is enough)
#   - Ollama: fully local and offline, no key. Install Ollama, then
#             `ollama pull qwen2.5:7b`. Used automatically when no key is set.
# The app prefers Gemini when a key is present, otherwise Ollama.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY="your-key-here"
# OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="qwen2.5:7b"

# --- Local Ollama as the T1 Pilot fallback (Server-2) ---
# Dual-Pilot: Kaggle writes the heavy batch screenplay (T3); when Kaggle is
# unset or times out the factory falls back to the local Ollama instance (T1,
# real time) at LOCAL_OLLAMA_URL. Both down -> an honest 503 PILOT_UNAVAILABLE.
# LOCAL_OLLAMA_URL is preferred over OLLAMA_URL for the Pilot fallback.
# LOCAL_OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_DISABLE="1"        # set to ignore Ollama entirely

# --- ComfyUI (free image AND video generation) ---
# COMFYUI_URL="http://127.0.0.1:8188"
# COMFYUI_CHECKPOINT="sd_xl_base_1.0.safetensors"
# COMFYUI_WORKFLOW="/path/to/your/image-workflow.json"   # optional, API format
# COMFYUI_VIDEO_WORKFLOW="/path/to/your/video-workflow.json"  # AnimateDiff/SVD, API format
#   A free Wan 2.1 1.3B template ships in the repo; point at it and set the
#   matching checkpoint:
#     COMFYUI_VIDEO_WORKFLOW="./workflows/comfyui_video_api.json"
#     COMFYUI_CHECKPOINT="wan2.1_t2v_1.3B_fp16.safetensors"
#   scripts/comfyui_video_kaggle_colab.ipynb installs those exact weights on a
#   free Kaggle/Colab GPU and prints the COMFYUI_URL to use.
#   The video workflow MUST contain placeholders the app fills before it posts to
#   ComfyUI /prompt: __PROMPT__, __NEGATIVE__, __SEED__, __WIDTH__, __HEIGHT__,
#   __FRAMES__, __CHECKPOINT__. Any other __LIKE_THIS__ token is refused with a
#   clear error instead of being sent to ComfyUI. Diagnose the whole chain with
#   GET /api/direk/video/backend.
# COMFYUI_LORAS_DIR="/path/to/ComfyUI/models/loras"
# COMFYUI_TIMEOUT_MS="180000"
# COMFYUI_DISABLE=""   # master on/off: 1 = ComfyUI off. The free engines then
#                      # catch the job, so a render still finishes. Same switch
#                      # as `comfyui_enabled` in SETUP / direk.config.json.

# --- kohya_ss / sd-scripts (LoRA training) ---
# KOHYA_DIR="C:\kohya_ss"                  # must contain train_network.py
# KOHYA_BASE_MODEL="C:\models\sd_xl_base_1.0.safetensors"
# KOHYA_PYTHON="python"        # Windows uses "python"; POSIX uses "python3"
# KOHYA_ACCELERATE="1"

# --- LoRA training backend ---
# local (default) runs kohya_ss here; colab hands the run to the Colab notebook
# scripts/colab_lora_train.ipynb through a Drive folder.
# TRAIN_BACKEND="local"
# COLAB_DRIVE_ROOT="G:\My Drive\LORA_TRAINING"   # a Drive for Desktop path (preferred)
# COLAB_DRIVE_FOLDER_ID=""                       # or a Drive folder id (Drive API v3)
# COLAB_POLL_MS="12000"                          # how often to read status.json

# --- Task routing (T1/T2/T3, protects the local GPU) ---
# T1 = chat/text/webhooks (CPU), T2 = image/Piper/small LoRA (local GPU),
# T3 = video (local ComfyUI GPU on Server-2) + large TTS/massive LoRA (cloud).
# T3_ALLOW_LOCAL="0"        # set to 0 so a non-video T3 job never runs on Server-2
# CLOUD_T3_URL=""           # cloud worker for non-video T3 offload (empty = queued only)

# --- NO-COST POLICY (the law of this app) ---
# Free-first is mandatory: every output path runs for free unless a deployment
# explicitly opts in to paid cloud. See docs/no-cost-audit.md for the full list
# of free and paid paths.
#   unset / 0   free only (the default). Paid engines are skipped, and the
#               reason is shown instead of spending money.
#   1           paid cloud services may run (Wan 2.2 on fal.ai, OpenCut,
#               Fish Audio, Gemini image).
# The local engines are always free and never need this switch: ComfyUI on the
# Server-2 GPU, the bundled offline Tagalog voice, Piper, ffmpeg, the asset
# store, the local Ollama, and the Gemini text/TTS free tier.
# ALLOW_PAID_CLOUD="0"

# --- fal.ai: Wan 2.2 (video generator) + OpenCut (video editor) ---
# Sponsored fal.ai endpoints. Wan 2.2 is the T3 video fallback used when the
# local ComfyUI cannot render a shot. OpenCut is an optional editing pass
# (cuts, transitions, colour grading) applied to a finished clip before it is
# saved to the Render Vault. Both need FAL_KEY AND ALLOW_PAID_CLOUD=1, because
# both are paid. When neither the ComfyUI nor Wan can render, the API answers
# 503 AI_UNAVAILABLE (never a placeholder clip).
# FAL_KEY=""                                        # https://fal.ai/dashboard/keys
# WAN_VIDEO_ENDPOINT="fal-ai/wan/v2.2-a14b/text-to-video"   # Video Generator
# OPENCUT_ENDPOINT=""                               # Video Editor; set to your fal.ai editing endpoint

# --- PREFERRED_RENDER_ENGINE: video render master switch ---
#   comfyui  Local-first (the default): try the local ComfyUI (Server-2 GPU)
#            first, then the free motion engine, then fall back to Wan 2.2 on
#            fal.ai when ALLOW_PAID_CLOUD=1. Switching ComfyUI off (see
#            COMFYUI_DISABLE) hands the job to the free engine, not an error.
#   fal      Cloud-first: route ALL video generation DIRECTLY to fal.ai
#            (Wan 2.2) and do NOT ping the local ComfyUI. Needs ALLOW_PAID_CLOUD=1.
#   motion   NO COST. Generate one free still (local ComfyUI when it is up, else
#            Pollinations — no key, no GPU, no account) and animate it with
#            ffmpeg into a real MP4. Use this to keep the no-cost rule without
#            any cloud spend.
#   stock    REAL FOOTAGE. Search Pexels or Pixabay for a clip shot on a real
#            camera, so the scene contains an actual person, animal, place,
#            weather or sky. Needs a free API key (PEXELS_API_KEY or
#            PIXABAY_API_KEY) and no GPU. Fails honestly when nothing matches
#            rather than returning a still.
#   hybrid   REAL FIRST, GENERATED FALLBACK. Try stock, and when there is no
#            match fall through to the normal ComfyUI/motion chain, so a scene
#            without footage is still rendered instead of dropped.
# Defaults to "comfyui" when unset: the free local-first chain (ComfyUI, then the
# free motion engine, then Wan 2.2). Only set "fal" to opt into paid cloud-first.
# PREFERRED_RENDER_ENGINE="comfyui"
# PEXELS_API_KEY=""                                  # free key: pexels.com/api
# PIXABAY_API_KEY=""                                 # free key: pixabay.com/api/docs
# PEXELS_API_URL=""                                  # override, e.g. a proxy
# PIXABAY_API_URL=""                                 # override, e.g. a proxy
# POLLINATIONS_URL="https://image.pollinations.ai"   # free image backend for "motion"
# POLLINATIONS_DISABLE=""                            # set to 1 to refuse the free backend
# MOTION_DISABLE=""                                  # set to 1 to refuse the "motion" engine

# --- Free connectors (local, no cloud account needed) ---
# Everything below is optional. Without it, connectors run locally with ffmpeg.
# FFMPEG_PATH=""            # use your own ffmpeg instead of the bundled one
# FFMPEG_FONT=""            # font file for burned-in text
# DIREK_ASSETS_DIR=""       # where renders are stored, default ./assets

# --- Google Drive upload (Drive API v3, free) ---
# https://developers.google.com/workspace/drive/api/reference/rest/v3
# GDRIVE_CLIENT_ID=""
# GDRIVE_CLIENT_SECRET=""
# GDRIVE_FOLDER_NAME="Direk"
# GDRIVE_FOLDER_ID=""       # optional, a specific folder id
# GDRIVE_REDIRECT_URI=""    # optional, must match the OAuth client
# APP_BASE_URL="http://127.0.0.1:12000"

# --- Kaggle Pilot (external cloud worker: Qwen 2.5 3B) ---
# The Kaggle Notebook is an EXTERNAL CLOUD WORKER. It does not run on this
# machine: it runs on Kaggle's GPU and is reached over the internet through a
# Cloudflare tunnel. Its source is scripts/direk_kaggle_pilot.ipynb (see
# docs/kaggle-pilot.md); upload that notebook to Kaggle and run all cells. Paste
# the tunnel URL it prints below. When it is down the app answers an honest 503
# PILOT_UNAVAILABLE and never invents a script.
# KAGGLE_PILOT_URL="https://xxxx-yyyy.trycloudflare.com"
# KAGGLE_PILOT_TOKEN=""               # optional bearer token for the tunnel
# KAGGLE_PILOT_TIMEOUT_MS="120000"
# KAGGLE_PILOT_SCRIPT_PATH="/generate_script"
# KAGGLE_PILOT_BIBLE_PATH="/generate_character_bible"
# KAGGLE_PILOT_SCENES_PATH="/breakdown_scenes"

# --- Narration voices (the film tries them in this order) ---
# 1. Fish Audio: best Tagalog, and can clone a voice. Needs a key.
#    https://fish.audio  ->  API key. Only the key is required; a reference_id
#    is optional and, when set, selects a cloned voice from your library.
# FISH_AUDIO_API_KEY=""
# FISH_AUDIO_REFERENCE_ID=""   # optional; without it Fish uses its default voice
# FISH_AUDIO_MODEL=""          # optional, provider default when empty
# 2. Offline Tagalog voice (Meta MMS VITS): free, CPU, real Tagalog, no quota.
#    Needs an interpreter with transformers, torch and soundfile:
#      python3 -m pip install transformers torch soundfile
#    It is on by default when those are present; otherwise it is skipped.
# TTS_TAGALOG_MODEL="tagalog"  # tagalog | filipino, or a full model id
# TTS_PYTHON="python3"         # interpreter with the packages above
# 3. Gemini cloud voice: TTS_DISABLE=1 turns it off.
# 4. Piper: an English backup voice (no Tagalog voice upstream). Point
#    TTS_PIPER_VOICE at a .onnx file.
# TTS_PIPER_BIN="piper"
# TTS_PIPER_VOICE=""
