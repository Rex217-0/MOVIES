# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a free-tier key at https://aistudio.google.com/apikey
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_AUTH_TOKEN: Bearer token that protects every /api route.
# Required when NODE_ENV=production (the server refuses to start without it).
# Leave empty for local development to disable auth.
APP_AUTH_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Local backends (optional). These can be left empty: open the app's SETUP
# panel and it writes direk.config.json for you. Environment variables still
# win over that file when both are set.
# ---------------------------------------------------------------------------
# COMFYUI_URL="http://127.0.0.1:8188"        # ComfyUI server (free images)
# COMFYUI_CHECKPOINT="sd_xl_base_1.0.safetensors"
# COMFYUI_LORAS_DIR="C:\\ComfyUI\\models\\loras"
# KOHYA_DIR="C:\\kohya_ss"                  # kohya_ss / sd-scripts (training)
# KOHYA_BASE_MODEL="C:\\models\\sd_xl_base_1.0.safetensors"
# KOHYA_PYTHON="python3"
# KOHYA_ACCELERATE="1"

# ---------------------------------------------------------------------------
# AI text model (Direk chat + Battle Room). Two free options:
#   - Gemini: set GEMINI_API_KEY (free tier is enough)
#   - Ollama: fully local and offline, no key. Install Ollama, then
#             `ollama pull qwen2.5:7b`. Used automatically when no key is set.
# The app prefers Gemini when a key is present, otherwise Ollama.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY="your-key-here"
# OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="qwen2.5:7b"

# --- ComfyUI (free image AND video generation) ---
# COMFYUI_URL="http://127.0.0.1:8188"
# COMFYUI_CHECKPOINT="sd_xl_base_1.0.safetensors"
# COMFYUI_WORKFLOW="/path/to/your/image-workflow.json"   # optional, API format
# COMFYUI_VIDEO_WORKFLOW="/path/to/your/video-workflow.json"  # AnimateDiff/SVD, API format
# COMFYUI_LORAS_DIR="/path/to/ComfyUI/models/loras"
# COMFYUI_TIMEOUT_MS="180000"
