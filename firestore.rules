rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each browser's anonymous Firebase Auth account can access only its own
    // Movie Maker history. Never use a UID supplied in an unauthenticated body.
    match /users/{userId}/movie_history/{movieId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
