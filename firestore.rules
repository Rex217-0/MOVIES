rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Movie Maker browser history is isolated to the current Firebase user.
    match /users/{userId}/movie_history/{movieId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['payload', 'createdAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 20000
        && request.resource.data.createdAt is timestamp;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Draft aligned with src/direk/factoryDb.ts MovieDoc:
    // id, title, genre, rating, format, status, created_at.
    // Admin SDK backend access bypasses Firestore rules. Client writes are
    // restricted to a trusted Firebase Auth custom claim set by a secure admin.
    // Reads are available to signed-in clients; without an owner field this is
    // project-wide visibility for authenticated users, so review before deploy.
    match /MovieJobs/{movieId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.token.admin == true
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'genre', 'rating', 'format', 'status', 'created_at'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'title', 'genre', 'rating', 'format', 'status', 'created_at'
        ])
        && request.resource.data.id is string
        && request.resource.data.id == movieId
        && request.resource.data.title is string
        && request.resource.data.genre is string
        && request.resource.data.rating is string
        && request.resource.data.format is string
        && request.resource.data.status in ['idle', 'running', 'paused', 'done', 'error']
        && request.resource.data.created_at is int;
      allow delete: if signedIn() && request.auth.token.admin == true;
    }

    // Draft aligned with src/direk/factoryDb.ts SceneDoc:
    // id, movie_id, scene_number, status, video_path.
    match /SceneJobs/{sceneId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.token.admin == true
        && request.resource.data.keys().hasOnly([
          'id', 'movie_id', 'scene_number', 'status', 'video_path'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'movie_id', 'scene_number', 'status', 'video_path'
        ])
        && request.resource.data.id is string
        && request.resource.data.id == sceneId
        && request.resource.data.movie_id is string
        && request.resource.data.scene_number is int
        && request.resource.data.scene_number >= 1
        && request.resource.data.scene_number <= 18
        && request.resource.data.status in ['pending', 'rendering', 'rendered', 'approved', 'rejected', 'failed']
        && (request.resource.data.video_path == null || request.resource.data.video_path is string);
      allow delete: if signedIn() && request.auth.token.admin == true;
    }

    // Default deny for every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
